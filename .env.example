# Copy to .env and fill in. Never commit .env.
LLMAPP_ENVIRONMENT=local

# fake | openai | anthropic
# The fake provider runs the whole offline test tier with no key.
LLMAPP_PROVIDER=fake

# Model identifiers live here, not in code.
# See Appendix B of the book for the current model matrix.
LLMAPP_MODEL=your_model_name_here
LLMAPP_API_KEY=your_api_key_here
LLMAPP_EMBEDDING_MODEL=your_embedding_model_here
LLMAPP_EMBEDDING_DIMENSIONS=1536

# Point at any OpenAI-compatible endpoint; blank uses the default.
LLMAPP_BASE_URL=

# Serving
LLMAPP_PORT=8000
LLMAPP_RATE_LIMIT_PER_MINUTE=60
# Production requires at least 32 bytes (RFC 7518, HS256).
LLMAPP_JWT_SECRET=

# Limits
LLMAPP_REQUEST_TIMEOUT_S=30
LLMAPP_MAX_OUTPUT_TOKENS=512
LLMAPP_DAILY_COST_LIMIT_USD=5.0

# Data
LLMAPP_CORPUS_DIR=corpus
LLMAPP_DATA_DIR=data
