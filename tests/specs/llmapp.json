{
 "openapi": "3.1.0",
 "info": {
  "title": "llmapp",
  "version": "1.0.0"
 },
 "paths": {
  "/healthz": {
   "get": {
    "summary": "Healthz",
    "description": "Liveness: is the process up?",
    "operationId": "healthz_healthz_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/readyz": {
   "get": {
    "summary": "Readyz",
    "description": "Readiness: can it serve a request right now?",
    "operationId": "readyz_readyz_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/v1/ask": {
   "post": {
    "summary": "Ask",
    "operationId": "ask_v1_ask_post",
    "parameters": [
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Authorization"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AskResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/ask/stream": {
   "post": {
    "summary": "Ask Stream",
    "description": "Stream prose. Structured fields arrive first.",
    "operationId": "ask_stream_v1_ask_stream_post",
    "parameters": [
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Authorization"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/ask/async": {
   "post": {
    "summary": "Ask Async",
    "operationId": "ask_async_v1_ask_async_post",
    "parameters": [
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Authorization"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JobAccepted"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/jobs/{job_id}": {
   "get": {
    "summary": "Job Status",
    "operationId": "job_status_v1_jobs__job_id__get",
    "parameters": [
     {
      "name": "job_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Job Id"
      }
     },
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Authorization"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JobStatus"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/v1/feedback": {
   "post": {
    "summary": "Feedback",
    "operationId": "feedback_v1_feedback_post",
    "parameters": [
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Authorization"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FeedbackRequest"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "AskRequest": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question"
     },
     "top_k": {
      "type": "integer",
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Top K",
      "default": 5
     },
     "filters": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Filters"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "question"
    ],
    "title": "AskRequest",
    "description": "What a caller may send."
   },
   "AskResponse": {
    "properties": {
     "request_id": {
      "type": "string",
      "title": "Request Id"
     },
     "answered": {
      "type": "boolean",
      "title": "Answered"
     },
     "answer": {
      "type": "string",
      "title": "Answer",
      "default": ""
     },
     "citations": {
      "items": {
       "$ref": "#/components/schemas/Citation"
      },
      "type": "array",
      "title": "Citations"
     },
     "missing": {
      "type": "string",
      "title": "Missing",
      "default": ""
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Sources"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "request_id",
     "answered"
    ],
    "title": "AskResponse",
    "description": "What a caller receives. Internals stay internal."
   },
   "Citation": {
    "properties": {
     "chunk_id": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Chunk Id"
     },
     "quote": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "title": "Quote"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "chunk_id",
     "quote"
    ],
    "title": "Citation",
    "description": "A claim traced back to the chunk that supports it."
   },
   "FeedbackRequest": {
    "properties": {
     "request_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "title": "Request Id"
     },
     "verdict": {
      "type": "string",
      "pattern": "^(good|bad|wrong_fact|missing|unsafe)$",
      "title": "Verdict"
     },
     "comment": {
      "type": "string",
      "maxLength": 1000,
      "title": "Comment",
      "default": ""
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "request_id",
     "verdict"
    ],
    "title": "FeedbackRequest"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Health": {
    "properties": {
     "status": {
      "type": "string",
      "title": "Status"
     },
     "checks": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Checks"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "status"
    ],
    "title": "Health"
   },
   "JobAccepted": {
    "properties": {
     "job_id": {
      "type": "string",
      "title": "Job Id"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "poll_after_seconds": {
      "type": "number",
      "title": "Poll After Seconds",
      "default": 1.0
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "job_id",
     "status"
    ],
    "title": "JobAccepted"
   },
   "JobStatus": {
    "properties": {
     "job_id": {
      "type": "string",
      "title": "Job Id"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "result": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AskResponse"
       },
       {
        "type": "null"
       }
      ]
     },
     "error": {
      "type": "string",
      "title": "Error",
      "default": ""
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "job_id",
     "status"
    ],
    "title": "JobStatus"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}